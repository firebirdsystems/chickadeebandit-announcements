{
  "id": "announcements",
  "name": "Announcements",
  "version": "1.0.0",
  "description": "Post household announcements with admin approval, expiration, and notification support — including optional email to every member.",
  "entrypoint": "index.html",
  "runtime": "static",
  "storage": "db",
  "category": "general",
  "tags": ["announcements", "notices", "admin"],
  "contexts": ["household", "shared_space", "shared_space.roster"],
  "data_access": {
    "reads": ["family.members", "family.groups"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "row_policies": {
    "announcements": {
      "kind": "owner_or_visibility",
      "member_column": "author_id",
      "visibility_column": "status",
      "everyone_values": ["pending", "approved", "archived"],
      "privileged_groups": [{ "settings_table": "settings", "settings_key": "moderator_group_id" }],
      "write_owner_only": true,
      "retain_days": {
        "default": 365,
        "timestamp_column": "created_at",
        "override_key": "announcement_history",
        "dependent_tables": [
          { "table": "approvals", "foreign_key": "announcement_id" },
          { "table": "acknowledgements", "foreign_key": "announcement_id" }
        ]
      }
    },
    "approvals": {
      "kind": "inherit_visibility",
      "fk_column": "announcement_id",
      "parent_table": "announcements",
      "writer_column": "approved_by",
      "insert_privileged_only": true
    },
    "acknowledgements": {
      "kind": "owner_only",
      "member_column": "member_id",
      "max_per_member": {
        "member_column": "member_id",
        "scope_columns": ["announcement_id"],
        "limit": 1
      }
    },
    "settings": {
      "kind": "app_config"
    }
  },
  "admin_config": {
    "settings_table": "settings",
    "keys": ["moderator_group_id"]
  },
  "publishes": ["announcement.submitted", "announcement.approved"],
  "alert_on": ["announcement.approved"],
  "member_references": {
    "announcements": [
      { "column": "author_id", "on_removed": "keep" },
      { "column": "approved_by", "on_removed": "keep" }
    ],
    "approvals": { "column": "approved_by", "on_removed": "keep" },
    "acknowledgements": { "column": "member_id", "on_removed": "delete", "id_column": "rowid" }
  },
  "publish_acls": {
    "announcement.submitted": { "require_role": "adult" },
    "announcement.approved":  {
      "require_group_setting": { "settings_table": "settings", "settings_key": "moderator_group_id" }
    }
  },
  "notification_acls": {
    "send": {
      "require_group_setting": { "settings_table": "settings", "settings_key": "moderator_group_id" }
    }
  },
  "automation_actions": {
    "post": {
      "title": "Post an announcement (already approved)",
      "description": "Post a notice that goes live immediately when another app's event fires. Use this for things nobody should have to wait on — a storm activation, an emergency check-in.",
      "params": {
        "title": { "type": "text", "label": "Title", "required": true },
        "body": { "type": "text", "label": "Body", "required": true },
        "days": { "type": "integer", "label": "Expires after (days)", "default": 14, "min": 1 },
        "is_critical": { "type": "boolean", "label": "Mark as critical", "default": false }
      },
      "dedupe": { "table": "announcements", "column": "source_event_id" },
      "steps": [
        {
          "op": "insert",
          "table": "announcements",
          "values": {
            "id": "$uuid",
            "title": ":title",
            "body": ":body",
            "status": "approved",
            "author_id": "automation",
            "author_name": "Automation",
            "is_critical": ":is_critical",
            "expires_at": "$now_plus_days(:days)",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        },
        {
          "op": "lookup",
          "table": "announcements",
          "where": { "source_event_id": "$event_id" },
          "bind": { "announcement_id": "id" },
          "on_missing": "error"
        },
        {
          "op": "insert",
          "table": "approvals",
          "values": {
            "announcement_id": ":announcement_id",
            "approved_by": "automation",
            "approved_at": "$now"
          }
        }
      ]
    },
    "post_for_approval": {
      "title": "Submit an announcement for approval",
      "description": "Queue a notice for a moderator to approve, exactly as a member's own submission would be. Use this when the event is worth telling people about but not worth bypassing review.",
      "params": {
        "title": { "type": "text", "label": "Title", "required": true },
        "body": { "type": "text", "label": "Body", "required": true },
        "days": { "type": "integer", "label": "Expires after (days)", "default": 14, "min": 1 }
      },
      "dedupe": { "table": "announcements", "column": "source_event_id" },
      "steps": [
        {
          "op": "insert",
          "table": "announcements",
          "values": {
            "id": "$uuid",
            "title": ":title",
            "body": ":body",
            "status": "pending",
            "author_id": "automation",
            "author_name": "Automation",
            "expires_at": "$now_plus_days(:days)",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "suggested_automations": [
    {
      "title": "Announce a storm activation immediately",
      "description": "Activating the emergency plan posts a critical announcement straight away — this is the case where waiting for a moderator to log in is the wrong behaviour.",
      "trigger_event": "emergency.storm_activated",
      "target_app_id": "announcements",
      "action_id": "post",
      "param_map": {
        "title": { "kind": "payload_field", "value": "title" },
        "body": { "kind": "const", "value": "The emergency plan has been activated. Open the emergency app to check in and see resources." },
        "days": { "kind": "const", "value": 7 },
        "is_critical": { "kind": "const", "value": true }
      }
    },
    {
      "title": "Submit an announcement when a survey opens",
      "description": "A new survey queues a notice for approval rather than posting itself, so routine traffic still passes a moderator.",
      "trigger_event": "survey.created",
      "target_app_id": "announcements",
      "action_id": "post_for_approval",
      "param_map": {
        "title": { "kind": "payload_field", "value": "title" },
        "body": { "kind": "const", "value": "A new survey is open. Add your answers when you get a moment." }
      }
    }
  ],
  "nav": {
    "label": "Announcements"
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT title AS title, author_name AS subtitle FROM app_announcements__announcements WHERE status = 'approved' AND substr(expires_at, 1, 10) >= :today ORDER BY created_at DESC LIMIT 3"
    },
    "display": { "template": "list", "title": "title", "subtitle": "subtitle" }
  },
  "widget": {
    "label": "Announcements",
    "size": "small"
  },
  "resource_limits": {
    "max_db_bytes": 5242880
  },
  "icon": "📢",
  "ai_access": {
    "allowed": true,
    "mode": "read_write",
    "db_exports": ["active_announcements", "pending_announcements"],
    "db_mutations": ["extend_expiry"],
    "db_inserts": ["create_announcement"]
  }
}
